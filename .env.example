# Скопируй этот файл в .env и настрой под своё окружение.

# PHP-сервер
# Linux (встроенный PHP-сервер: php -S localhost:8000 -t .):
PHP_SERVER=http://localhost:8000
# Windows WAMP (если папка называется chpinterest):
# PHP_SERVER=http://localhost/chpinterest

# База данных
DB_HOST=127.0.0.1
DB_NAME=!saygex
DB_USER=chpuser
DB_PASS=chppass
